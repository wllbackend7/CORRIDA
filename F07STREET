import React, { useState, useEffect } from 'react';
import { Activity, Calendar, CheckCircle, Flame, Play, Pause, RotateCcw, Save, Trophy, Dumbbell, History } from 'lucide-react';

const PLANOS_TREINO = {
  '5k': {
    titulo: 'Meta 5K (< 25 min)',
    paceAlvo: '4:55 - 4:59 min/km',
    foco: 'Velocidade e Ganho de VO2 Máx',
    semanas: [
      {
        semana: 1,
        treinos: [
          { id: '5k-1-1', tipo: 'Tiro', titulo: 'Tiros Curtos de Ajuste', detalhe: 'Aquecimento 10m + 8x 400m @ 4:20 min/km (1m desc.) + 5m desaquec.' },
          { id: '5k-1-2', tipo: 'Fortalecimento', titulo: 'Membros Inferiores + Core', detalhe: '3x12 Agachamento, 3x10 Afundo, 3x45s Prancha' },
          { id: '5k-1-3', tipo: 'Rodagem', titulo: 'Rodagem Regenerativa', detalhe: '5 km em ritmo leve/confortável (Pace 5:40 - 6:00 min/km)' }
        ]
      }
    ]
  },
  '10k': {
    titulo: 'Meta 10K (< 40 min)',
    paceAlvo: '3:55 - 3:59 min/km',
    foco: 'Limiar Anaeróbico e Potência',
    semanas: [
      {
        semana: 1,
        treinos: [
          { id: '10k-1-1', tipo: 'Tiro', titulo: 'Tiros Longos de Limiar', detalhe: 'Aquecimento 10m + 5x 1000m @ 3:45 min/km (90s desc.) + 5m desaquec.' },
          { id: '10k-1-2', tipo: 'Fortalecimento', titulo: 'Força Explosiva e Quadril', detalhe: '3x10 Agachamento Búlgaro, 3x12 Elevação Pélvica, 3x15 Panturrilha' },
          { id: '10k-1-3', tipo: 'Rodagem', titulo: 'Tempo Run (Ritmo Sustentado)', detalhe: '7 km contínuos travados em Pace 4:10 min/km' }
        ]
      }
    ]
  },
  '21k': {
    titulo: 'Meta 21K (< 1h00)',
    paceAlvo: '2:48 - 2:50 min/km',
    foco: 'Alta Performance e Economia de Corrida',
    semanas: [
      {
        semana: 1,
        treinos: [
          { id: '21k-1-1', tipo: 'Tiro', titulo: 'Intervalado de Alta Velocidade', detalhe: 'Aquecimento 15m + 4x 2000m @ 2:45 min/km (2m desc.) + 10m desaquec.' },
          { id: '21k-1-2', tipo: 'Fortalecimento', titulo: 'Resistência Muscular e Core', detalhe: '4x15 Agachamento com peso, 4x12 Stiff, 4x1m Prancha Dinâmica' },
          { id: '21k-1-3', tipo: 'Rodagem', titulo: 'Longão Progressivo', detalhe: '14 km (Início a 3:15 min/km, terminando os últimos 4 km a 2:50 min/km)' }
        ]
      }
    ]
  }
};

export default function App() {
  const [planoAtivo, setPlanoAtivo] = useState('5k');
  const [treinoSelecionado, setTreinoSelecionado] = useState(null);
  
  // Estado do Histórico de Desempenho
  const [historico, setHistorico] = useState(() => {
    const salvos = localStorage.getItem('historico_treinos');
    return salvos ? JSON.parse(salvos) : [];
  });

  // Estado do Cronômetro
  const [tempoSegundos, setTempoSegundos] = useState(0);
  const [ativo, setAtivo] = useState(false);

  // Formulário do Registro
  const [distanciaReal, setDistanciaReal] = useState('');
  const [tempoReal, setTempoReal] = useState('');
  const [pse, setPse] = useState('7');

  useEffect(() => {
    localStorage.setItem('historico_treinos', JSON.stringify(historico));
  }, [historico]);

  useEffect(() => {
    let intervalo = null;
    if (ativo) {
      intervalo = setInterval(() => {
        setTempoSegundos(t => t + 1);
      }, 1000);
    } else {
      clearInterval(intervalo);
    }
    return () => clearInterval(intervalo);
  }, [ativo]);

  const formatarTempo = (totalSegundos) => {
    const mins = Math.floor(totalSegundos / 60);
    const segs = totalSegundos % 60;
    return `${mins.toString().padStart(2, '0')}:${segs.toString().padStart(2, '0')}`;
  };

  const salvarDesempenho = (e) => {
    e.preventDefault();
    if (!treinoSelecionado) return;

    const novoRegistro = {
      id: Date.now(),
      treinoId: treinoSelecionado.id,
      titulo: treinoSelecionado.titulo,
      tipo: treinoSelecionado.tipo,
      data: new Date().toLocaleDateString('pt-BR'),
      distancia: distanciaReal ? `${distanciaReal} km` : 'N/I',
      tempo: tempoReal || formatarTempo(tempoSegundos),
      pse: pse
    };

    setHistorico([novoRegistro, ...historico]);
    setDistanciaReal('');
    setTempoReal('');
    setTempoSegundos(0);
    setAtivo(false);
  };

  const plano = PLANOS_TREINO[planoAtivo];

  return (
    <div className="min-h-screen bg-slate-900 text-slate-100 p-4 md:p-8 font-sans">
      <div className="max-w-3xl mx-auto space-y-6">
        
        {/* Header */}
        <header className="flex items-center justify-between pb-4 border-b border-slate-800">
          <div>
            <h1 className="text-2xl font-bold flex items-center gap-2 text-indigo-400">
              <Activity className="w-7 h-7" /> PaceMaster Pro
            </h1>
            <p className="text-xs text-slate-400">Gerenciador & Cronômetro de Treinos</p>
          </div>
          <div className="bg-slate-800 px-3 py-1.5 rounded-lg border border-slate-700 text-xs font-semibold text-emerald-400 flex items-center gap-1.5">
            <CheckCircle className="w-4 h-4" /> {historico.length} Feitos
          </div>
        </header>

        {/* Seleção de Meta */}
        <div className="grid grid-cols-3 gap-2">
          {['5k', '10k', '21k'].map((meta) => (
            <button
              key={meta}
              onClick={() => { setPlanoAtivo(meta); setTreinoSelecionado(null); }}
              className={`py-3 rounded-xl font-bold uppercase transition-all ${
                planoAtivo === meta
                  ? 'bg-indigo-600 text-white shadow-lg shadow-indigo-500/30'
                  : 'bg-slate-800 text-slate-400 hover:bg-slate-700'
              }`}
            >
              Plano {meta}
            </button>
          ))}
        </div>

        {/* Card da Meta Ativa */}
        <div className="bg-slate-800/60 border border-slate-700 rounded-2xl p-5 backdrop-blur-sm">
          <div className="flex justify-between items-start mb-2">
            <h2 className="text-xl font-bold text-white">{plano.titulo}</h2>
            <span className="bg-amber-500/20 text-amber-300 text-xs font-bold px-2.5 py-1 rounded-full border border-amber-500/30">
              Pace {plano.paceAlvo}
            </span>
          </div>
          <p className="text-sm text-slate-300 flex items-center gap-1">
            <Flame className="w-4 h-4 text-orange-400" /> Foco: {plano.foco}
          </p>
        </div>

        {/* Cronômetro e Painel de Treino Ativo */}
        {treinoSelecionado && (
          <div className="bg-indigo-950/40 border border-indigo-500/40 rounded-2xl p-6 space-y-5 animate-fadeIn">
            <div className="flex justify-between items-center border-b border-indigo-500/20 pb-3">
              <div>
                <span className="text-xs font-bold uppercase tracking-wider text-indigo-400">Treino Em Execução</span>
                <h3 className="text-lg font-bold text-white">{treinoSelecionado.titulo}</h3>
              </div>
              <button 
                onClick={() => setTreinoSelecionado(null)} 
                className="text-xs text-slate-400 hover:text-white"
              >
                Fechar
              </button>
            </div>

            {/* Temporizador */}
            <div className="flex flex-col items-center justify-center bg-slate-900/80 p-6 rounded-xl border border-slate-800">
              <div className="text-5xl font-mono font-bold text-indigo-300 mb-4 tracking-wider">
                {formatarTempo(tempoSegundos)}
              </div>
              <div className="flex gap-3">
                <button
                  onClick={() => setAtivo(!ativo)}
                  className={`px-5 py-2.5 rounded-lg font-bold flex items-center gap-2 transition-all ${
                    ativo ? 'bg-amber-600 hover:bg-amber-500' : 'bg-emerald-600 hover:bg-emerald-500'
                  }`}
                >
                  {ativo ? <><Pause className="w-4 h-4"/> Pausar</> : <><Play className="w-4 h-4"/> Iniciar</>}
                </button>
                <button
                  onClick={() => { setAtivo(false); setTempoSegundos(0); }}
                  className="px-4 py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg flex items-center gap-2"
                >
                  <RotateCcw className="w-4 h-4" /> Zerar
                </button>
              </div>
            </div>

            {/* Form de Registro */}
            <form onSubmit={salvarDesempenho} className="space-y-4 pt-2">
              <h4 className="text-sm font-bold text-slate-300 flex items-center gap-1.5">
                <Save className="w-4 h-4 text-indigo-400" /> Registrar Resultado do Treino
              </h4>
              
              <div className="grid grid-cols-2 gap-3">
                <div>
                  <label className="text-xs text-slate-400 block mb-1">Distância (km)</label>
                  <input
                    type="number"
                    step="0.01"
                    placeholder="Ex: 5.0"
                    value={distanciaReal}
                    onChange={(e) => setDistanciaReal(e.target.value)}
                    className="w-full bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-sm text-white focus:border-indigo-500 outline-none"
                  />
                </div>
                <div>
                  <label className="text-xs text-slate-400 block mb-1">Tempo (MM:SS)</label>
                  <input
                    type="text"
                    placeholder="Ex: 24:30"
                    value={tempoReal}
                    onChange={(e) => setTempoReal(e.target.value)}
                    className="w-full bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-sm text-white focus:border-indigo-500 outline-none"
                  />
                </div>
              </div>

              <div>
                <label className="text-xs text-slate-400 block mb-1">Percepção de Esforço (PSE 1-10)</label>
                <input
                  type="range"
                  min="1"
                  max="10"
                  value={pse}
                  onChange={(e) => setPse(e.target.value)}
                  className="w-full accent-indigo-500"
                />
                <div className="flex justify-between text-[10px] text-slate-500 mt-1">
                  <span>1 Leve</span>
                  <span>5 Moderado</span>
                  <span>10 Máximo</span>
                </div>
              </div>

              <button
                type="submit"
                className="w-full py-3 bg-indigo-600 hover:bg-indigo-500 text-white font-bold rounded-xl shadow-lg shadow-indigo-600/30 transition-all flex items-center justify-center gap-2"
              >
                <CheckCircle className="w-5 h-5" /> Salvar Treino no Histórico
              </button>
            </form>
          </div>
        )}

        {/* Lista de Treinos Programados */}
        <div className="space-y-4">
          <h3 className="text-sm font-bold text-slate-400 uppercase tracking-wider flex items-center gap-2">
            <Calendar className="w-4 h-4" /> Treinos da Semana
          </h3>

          {plano.semanas[0].treinos.map((treino) => (
            <div
              key={treino.id}
              onClick={() => setTreinoSelecionado(treino)}
              className={`p-4 rounded-xl border transition-all cursor-pointer flex items-center justify-between gap-4 ${
                treinoSelecionado?.id === treino.id
                  ? 'bg-indigo-900/40 border-indigo-500'
                  : 'bg-slate-800 border-slate-700 hover:border-slate-600'
              }`}
            >
              <div className="space-y-1">
                <div className="flex items-center gap-2">
                  <span className={`text-[10px] font-bold uppercase px-2 py-0.5 rounded ${
                    treino.tipo === 'Tiro' ? 'bg-red-500/20 text-red-400' :
                    treino.tipo === 'Fortalecimento' ? 'bg-purple-500/20 text-purple-400' :
                    'bg-blue-500/20 text-blue-400'
                  }`}>
                    {treino.tipo}
                  </span>
                  <h4 className="font-semibold text-sm text-slate-100">{treino.titulo}</h4>
                </div>
                <p className="text-xs text-slate-400 leading-relaxed">{treino.detalhe}</p>
              </div>

              <button className="shrink-0 p-2.5 bg-slate-700 hover:bg-indigo-600 rounded-lg text-white transition-colors">
                <Play className="w-4 h-4" />
              </button>
            </div>
          ))}
        </div>

        {/* Histórico Registrado */}
        {historico.length > 0 && (
          <div className="space-y-3 pt-4 border-t border-slate-800">
            <h3 className="text-sm font-bold text-slate-400 uppercase tracking-wider flex items-center gap-2">
              <History className="w-4 h-4" /> Histórico de Treinos
            </h3>
            <div className="space-y-2">
              {historico.map((reg) => (
                <div key={reg.id} className="p-3 bg-slate-800/40 border border-slate-700/60 rounded-lg flex justify-between items-center text-xs">
                  <div>
                    <span className="font-bold text-slate-200 block">{reg.titulo}</span>
                    <span className="text-slate-500">{reg.data} • PSE: {reg.pse}/10</span>
                  </div>
                  <div className="text-right">
                    <span className="text-indigo-400 font-mono font-bold block">{reg.tempo}</span>
                    <span className="text-slate-400">{reg.distancia}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

      </div>
    </div>
  );
}
